&lt;h1>Simulate some data&lt;/h1>
&lt;pre class="r">&lt;code>n &amp;lt;- 1000&lt;/code>&lt;/pre>
&lt;pre class="r">&lt;code>
d &amp;lt;- tibble(
 x = rnorm(n, mean = 0, sd = 1),
 y = rnorm(n, mean = 0, sd = 1),
 e = rnorm(n, mean = 0, sd = 0.3),
 z = abs(x) * abs(y))&lt;/code>&lt;/pre>
